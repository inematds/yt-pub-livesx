# Google Cloud OAuth (Desktop App)
CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_SECRET=GOCSPX-your-secret

# YouTube Data API Key
API_KEY=AIzaSy-your-api-key

# Google Cloud Project
GCP_PROJECT=your-project-id

# YouTube Channel ID
YOUTUBE_CHANNEL_ID=UC-your-channel-id

# Google Spreadsheet ID (dashboard data)
SPREADSHEET_ID=your-spreadsheet-id

# Diretorio de lives processadas (Docker: /data/lives)
# LIVES_DIR=/data/lives

# Senha de acesso aos dashboards web (padrao: Inema2026$$$)
DASHBOARD_PASSWORD=Inema2026$$$

# --- Telegram (somente no master-dashboard) ---
# Bot do monitor de saude das instancias
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# Bot DEDICADO para avisar publicacoes (nao reutilizar o token acima:
# dois processos pollando o mesmo token dao 409 Conflict).
# O chat_id de cada canal e configurado no dashboard da instancia.
# TELEGRAM_NOTIFY_BOT_TOKEN=
